# Resolution of the voxel grid filter in meters
# If not set the map will be published with the resolution of the graph slam
# For negative values the full map will be published
float64 resolution

# Count threshold for the voxel grid filter, all cells with less points will be removed
int64 count_threshold -1

# Frame id of the published point cloud
# If empty the map will be published in the map frame of the graph slam
string frame_id

# Whether to skip the point cloud associated with the very first keyframe.
# This cloud might include points of other dynamic robots, 
# participating in the Multi-Robot-Graph-SLAM, 
# which would be filtered after the very first keyframe.
bool skip_first_cloud false


---

bool success
